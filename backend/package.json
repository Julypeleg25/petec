{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "start": "node dist/server.js",
    "migrate:medicines-extra": "tsx src/scripts/migrations/migrateMedicinesExtraInfo.cli.ts",
    "seed": "tsx src/seed/seed.ts",
