{
  "name": "petec",
  "private": true,
  "packageManager": "npm@10",
  "workspaces": ["frontend","backend","packages/shared"],
  "scripts": {
    "install:clean": "rimraf node_modules package-lock.json && npm install",
    "build": "npm run -w @petec/shared build && npm run -w backend build && npm run -w frontend build",
    "typecheck": "npm run -w @petec/shared typecheck && npm run -w backend typecheck && npm run -w frontend typecheck",
    "dev:backend": "npm run -w backend dev",
    "dev:frontend": "npm run -w frontend start",
    "stacked:current:plan": "node scripts/commit-stacked-current.cjs --plan",
    "stacked:current:run": "node scripts/commit-stacked-current.cjs",
    "stacked:current:manifest": "node scripts/build-current-manifest-from-plan.cjs",
    "stacked:current:explicit:plan": "node scripts/commit-stacked-current-explicit.cjs --plan",
    "stacked:current:explicit:run": "node scripts/commit-stacked-current-explicit.cjs"
  },
  "devDependencies": {
    "rimraf": "^6.0.1"
  }
}
